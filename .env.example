# NEXMINT AI environment template
#
# Do not commit real private keys, API keys, JWT secrets, database URLs, or RPC
# private endpoints. Use testnet keys first. Mainnet deployments should use
# secure key management, restricted deployer permissions, and separated treasury
# operations.

# App
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# API
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/nexmint

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_me
AUTH_NONCE_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=12

# Wallet / Web3
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532
NEXT_PUBLIC_ENABLE_TESTNET_MODE=true
DEFAULT_CHAIN_ID=84532
ENABLE_TESTNET_MODE=true

# RPC URLs
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
