NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

MONGODB_URI=mongodb://mongo:27017/nexmint
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
AUTH_NONCE_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PINATA_JWT=
PINATA_UPLOAD_MODE=auto
PINATA_NETWORK=public
# You can use either a plain gateway base URL:
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# or a Pinata dedicated gateway URL with pinataGatewayToken query.
# If you paste a full /ipfs/<cid>?pinataGatewayToken=... URL, the app keeps the gateway token and replaces the CID per upload.
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# Optional read token for private/dedicated Pinata gateways. Prefer this instead of pasting the token into every URL.
PINATA_GATEWAY_TOKEN=
IPFS_PROVIDER=auto
NFT_STORAGE_TOKEN=
NFT_STORAGE_API_KEY=
NFT_STORAGE_GATEWAY_URL=https://nftstorage.link/ipfs
UPLOAD_DIR=uploads

