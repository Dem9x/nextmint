REPLICATE_DEFAULT_TEXT_TO_IMAGE_MODEL=black-forest-labs/flux-schnell
AI_FREE_TIER_MODE=true
AI_MAX_DAILY_FREE_REQUESTS=50
AI_IMAGE_GENERATION_TIMEOUT_MS=120000

# AI / generation limits
